rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net — deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles — stores role and display name
    // Each authenticated user can read/write only their own profile
    match /userProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        incoming().keys().hasAll(['role', 'displayName']) &&
        incoming().role is string &&
        incoming().displayName is string;
      allow update: if isOwner(userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role', 'displayName', 'updatedAt']);
      allow delete: if false;
    }

    // Validation helpers
    function isValidPatient(data) {
      return data.keys().hasAll(['name', 'phone', 'fileNumber']) &&
             data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.fileNumber is string && data.fileNumber.size() <= 20;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientId', 'date', 'startTime']) &&
             data.patientId is string && data.patientId.size() <= 100 &&
             data.date is string &&
             data.startTime is string;
    }

    // Patients — authenticated users only
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPatient(incoming());
      allow update: if isSignedIn() && isValidPatient(incoming());
      allow delete: if isSignedIn();
    }

    // Appointments — authenticated users only
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAppointment(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Clinical records — authenticated users only
    match /records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Drugs / pharmacy — authenticated users only
    match /drugs/{drugId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Financial transactions — authenticated users only
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
    }

    // Queue — authenticated users only
    match /queue/{queueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
