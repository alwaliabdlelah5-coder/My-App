rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // PATIENTS
    // -------------------------------------------------------------------------
    function isValidPatient(data) {
      return data.keys().hasAll(['fileNumber', 'name', 'phone', 'gender', 'birthDate', 'status'])
        && data.fileNumber is string && data.fileNumber.size() <= 64
        && data.name is string && data.name.size() <= 256
        && data.phone is string && data.phone.size() <= 32
        && data.gender in ['ذكر', 'أنثى', 'male', 'female']
        && data.status in ['active', 'inactive'];
    }

    match /patients/{patientId} {
      allow get, list: if true; // Relaxed for development
      allow create: if true; // Relaxed for seeder
      allow update: if true; // Relaxed for development
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // APPOINTMENTS
    // -------------------------------------------------------------------------
    function isValidAppointment(data) {
      return data.keys().hasAll(['patientName', 'doctorName', 'date', 'startTime', 'status'])
        && data.patientName is string && data.patientName.size() <= 256
        && data.doctorName is string && data.doctorName.size() <= 256
        && data.status in ['confirmed', 'waiting', 'cancelled', 'completed']
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startTime is string && data.startTime.matches('^\\d{2}:\\d{2}$')
        // Ensure appointment is in the future
        && timestamp(data.date + 'T' + data.startTime + ':00Z') >= request.time;
    }

    match /appointments/{appointmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidAppointment(incoming());
      allow update: if isSignedIn() && isValidAppointment(incoming()) && (
        // Allow updating other fields if status is unchanged
        (incoming().status == existing().status) || 
        // Restricted status transitions: confirmed/waiting -> cancelled/completed
        (
          existing().status in ['confirmed', 'waiting'] && 
          incoming().status in ['cancelled', 'completed'] && 
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // DRUGS (INVENTORY/PHARMACY)
    // -------------------------------------------------------------------------
    function isValidDrug(data) {
      return data.keys().hasAll(['name', 'scientificName', 'category', 'stock', 'expiry', 'price'])
        && data.name is string && data.name.size() <= 256
        && data.scientificName is string && data.scientificName.size() <= 256
        && data.stock is int && data.stock >= 0;
    }

    match /drugs/{drugId} {
      allow get, list: if true; // Relaxed for development
      allow create: if true; // Relaxed for seeder
      allow update: if true; // Relaxed for development
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // TRANSACTIONS
    // -------------------------------------------------------------------------
    function isValidTransaction(data) {
      return data.keys().hasAll(['description', 'type', 'amount', 'category', 'method', 'date'])
        && data.description is string && data.description.size() <= 500
        && data.type in ['income', 'expense']
        && data.amount is number && data.amount >= 0
        && data.method in ['cash', 'card', 'transfer'];
    }

    match /transactions/{transactionId} {
      allow get, list: if true; // Relaxed for development
      allow create: if true; // Relaxed for seeder
      allow update: if isAdmin() || true;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // LAB TESTS
    // -------------------------------------------------------------------------
    match /lab_tests/{testId} {
      allow get, list: if true; // Relaxed for development
      allow write: if isAdmin() || true;
    }

    // -------------------------------------------------------------------------
    // QUEUE
    // -------------------------------------------------------------------------
    function isValidQueueItem(data) {
      return data.keys().hasAll(['patientName', 'status', 'priority'])
        && data.patientName is string && data.patientName.size() <= 256
        && data.status in ['waiting', 'in_progress', 'completed', 'cancelled']
        && data.priority in ['normal', 'urgent', 'emergency'];
    }

    match /queue/{itemId} {
      allow get, list: if true; // Relaxed for development
      allow create: if true; // Relaxed for seeder
      allow update: if true; // Relaxed for development
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ADMINS (Collection for RBAC)
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or specialized tool
    }
  }
}
