{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Patient medical record information",
      "type": "object",
      "properties": {
        "fileNumber": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["ذكر", "أنثى"] },
        "birthDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fileNumber", "name", "phone", "gender", "birthDate", "status"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Medical appointment schedule",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "duration": { "type": "integer" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "waiting", "cancelled", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientName", "doctorName", "date", "startTime", "status"]
    },
    "Drug": {
      "title": "Drug",
      "description": "Pharmacy and inventory drug information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "scientificName": { "type": "string" },
        "category": { "type": "string" },
        "stock": { "type": "integer" },
        "expiry": { "type": "string" },
        "price": { "type": "string" },
        "brandNames": { "type": "array", "items": { "type": "string" } },
        "isNearingExpiry": { "type": "boolean" }
      },
      "required": ["name", "scientificName", "category", "stock", "expiry", "price"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial records",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "method": { "type": "string", "enum": ["cash", "card", "transfer"] },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "type", "amount", "category", "method", "date"]
    },
    "LabTest": {
      "title": "LabTest",
      "description": "Laboratory test types and pricing",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["name", "category", "price"]
    },
    "QueueItem": {
      "title": "QueueItem",
      "description": "Patient waiting queue item",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorName": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "in_progress", "completed", "cancelled"] },
        "priority": { "type": "string", "enum": ["normal", "urgent", "emergency"] },
        "startTime": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientName", "status", "priority"]
    },
    "User": {
      "title": "User",
      "description": "System user and staff information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["نشط", "غير نشط"] },
        "email": { "type": "string", "format": "email" },
        "lastLogin": { "type": "string" }
      },
      "required": ["name", "role", "status", "email"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System activity log",
      "type": "object",
      "properties": {
        "user": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string", "enum": ["warning", "info", "success"] }
      },
      "required": ["user", "action", "time", "type"]
    }
  },
  "firestore": {
    "patients": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Collection of patient records"
    },
    "appointments": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Collection of appointments"
    },
    "drugs": {
      "schema": { "$ref": "#/entities/Drug" },
      "description": "Collection of pharmacy drugs and inventory items"
    },
    "transactions": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Collection of financial transactions"
    },
    "lab_tests": {
      "schema": { "$ref": "#/entities/LabTest" },
      "description": "Collection of laboratory tests"
    },
    "queue": {
      "schema": { "$ref": "#/entities/QueueItem" },
      "description": "Collection of items in the clinic queue"
    },
    "users": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of system operators"
    },
    "audit_logs": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Collection of system activity logs"
    }
  }
}
