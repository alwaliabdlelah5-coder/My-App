{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Information about a patient",
      "type": "object",
      "properties": {
        "fileNumber": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "gender": { "type": "string" },
        "birthDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "fileNumber"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled medical appointment",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "duration": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "waiting", "cancelled", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "date", "startTime"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "A clinical encounter record",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "visitDate": { "type": "string", "format": "date-time" },
        "vitals": {
          "type": "object",
          "properties": {
            "bpSystolic": { "type": "number" },
            "bpDiastolic": { "type": "number" },
            "pulse": { "type": "number" },
            "temp": { "type": "number" },
            "weight": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "complaint": { "type": "string" },
        "diagnosis": { "type": "string" },
        "prescription": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "LabTest": {
      "title": "Lab Test",
      "description": "A laboratory test with parameters",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "unit": { "type": "string" },
              "minRangeMale": { "type": "number" },
              "maxRangeMale": { "type": "number" },
              "minRangeFemale": { "type": "number" },
              "maxRangeFemale": { "type": "number" }
            }
          }
        },
        "price": { "type": "number" }
      }
    },
    "Employee": {
      "title": "Employee",
      "description": "Staff member information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "salary": { "type": "number" },
        "contractType": { "type": "string" },
        "joinDate": { "type": "string", "format": "date" }
      }
    },
    "Drug": {
      "title": "Drug",
      "description": "Pharmacological product",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "scientificName": { "type": "string" },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "expiry": { "type": "string", "format": "date" },
        "price": { "type": "string" },
        "brandNames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "method": { "type": "string", "enum": ["cash", "card", "transfer"] },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "QueueItem": {
      "title": "Queue Item",
      "description": "A patient in the waiting queue",
      "type": "object",
      "properties": {
        "patientName": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "in_progress", "completed", "cancelled"] },
        "priority": { "type": "string", "enum": ["normal", "urgent", "emergency"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/patients/{patientId}": { "schema": "Patient", "description": "Patient profiles" },
    "/appointments/{appointmentId}": { "schema": "Appointment", "description": "Scheduled appointments" },
    "/records/{recordId}": { "schema": "MedicalRecord", "description": "Clinical encounter records" },
    "/drugs/{drugId}": { "schema": "Drug", "description": "Pharmacy drugs" },
    "/lab_tests/{testId}": { "schema": "LabTest", "description": "Catalog of lab tests" },
    "/employees/{empId}": { "schema": "Employee", "description": "Staff records" },
    "/invoices/{invoiceId}": { "schema": "Invoice", "description": "Billing records" },
    "/transactions/{transactionId}": { "schema": "Transaction", "description": "Financial ledger" },
    "/queue/{queueId}": { "schema": "QueueItem", "description": "Real-time patient queue" }
  }
}
