# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Environment Configuration
NEXT_PUBLIC_APP_ENV="development" # development, staging, production
PROJECT_ID="integrated-medical-center"
# Medical System Configuration
NEXT_PUBLIC_API_URL=https://api.medical.ye
NEXT_PUBLIC_DB_TYPE=postgresql
DATABASE_URL=
DB_USER=
DB_PASS=

# Infrastructure Secrets
SUPABASE_PROD_DB=
FIREBASE_SERVICE_ACCOUNT=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=medical-center-prod
