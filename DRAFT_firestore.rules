rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // PATIENTS
    // -------------------------------------------------------------------------
    function isValidPatient(data) {
      return data.keys().hasAll(['fileNumber', 'name', 'phone', 'gender', 'birthDate', 'status'])
        && data.fileNumber is string && data.fileNumber.size() <= 64
        && data.name is string && data.name.size() <= 256
        && data.phone is string && data.phone.size() <= 32
        && data.gender in ['ذكر', 'أنثى']
        && data.status in ['active', 'inactive'];
    }

    match /patients/{patientId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidPatient(incoming())
        && isValidId(patientId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidPatient(incoming())
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'gender', 'birthDate', 'status', 'updatedAt'])
           && incoming().updatedAt == request.time
           && incoming().createdAt == existing().createdAt)
          || isAdmin()
        );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // APPOINTMENTS
    // -------------------------------------------------------------------------
    function isValidAppointment(data) {
      return data.keys().hasAll(['patientName', 'doctorName', 'date', 'startTime', 'status'])
        && data.patientName is string && data.patientName.size() <= 256
        && data.doctorName is string && data.doctorName.size() <= 256
        && data.status in ['confirmed', 'waiting', 'cancelled', 'completed'];
    }

    match /appointments/{appointmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidAppointment(incoming())
        && isValidId(appointmentId)
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status'])
           && incoming().status in ['confirmed', 'waiting', 'cancelled', 'completed'])
          || isAdmin()
        );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // DRUGS (INVENTORY/PHARMACY)
    // -------------------------------------------------------------------------
    function isValidDrug(data) {
      return data.keys().hasAll(['name', 'scientificName', 'category', 'stock', 'expiry', 'price'])
        && data.name is string && data.name.size() <= 256
        && data.scientificName is string && data.scientificName.size() <= 256
        && data.stock is int && data.stock >= 0;
    }

    match /drugs/{drugId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn()
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['stock']) && incoming().stock >= 0)
          || isAdmin()
        );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // TRANSACTIONS
    // -------------------------------------------------------------------------
    function isValidTransaction(data) {
      return data.keys().hasAll(['description', 'type', 'amount', 'category', 'method', 'date'])
        && data.description is string && data.description.size() <= 500
        && data.type in ['income', 'expense']
        && data.amount is number && data.amount >= 0
        && data.method in ['cash', 'card', 'transfer'];
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // LAB TESTS
    // -------------------------------------------------------------------------
    match /lab_tests/{testId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // QUEUE
    // -------------------------------------------------------------------------
    function isValidQueueItem(data) {
      return data.keys().hasAll(['patientName', 'status', 'priority'])
        && data.patientName is string && data.patientName.size() <= 256
        && data.status in ['waiting', 'in_progress', 'completed', 'cancelled']
        && data.priority in ['normal', 'urgent', 'emergency'];
    }

    match /queue/{itemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidQueueItem(incoming())
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && (
          (incoming().diff(existing()).affectedKeys().hasAny(['status', 'startTime'])
           && incoming().status in ['waiting', 'in_progress', 'completed', 'cancelled'])
          || isAdmin()
        );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ADMINS (Collection for RBAC)
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or specialized tool
    }
  }
}
