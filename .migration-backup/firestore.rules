rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entities Validation
    function isValidPatient(data) {
      return data.keys().hasAll(['name', 'phone', 'fileNumber']) &&
             data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.fileNumber is string && data.fileNumber.size() <= 20;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientId', 'date', 'startTime']) &&
             data.patientId is string && data.patientId.size() <= 100 &&
             data.date is string &&
             data.startTime is string;
    }

    // Collections
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPatient(incoming());
      allow update: if isSignedIn() && isValidPatient(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'status', 'updatedAt'])
      );
      allow delete: if false; // Only admins via console for now
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAppointment(incoming());
      allow update: if isSignedIn() && isValidAppointment(incoming());
      allow delete: if isSignedIn();
    }

    match /records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['complaint', 'diagnosis', 'prescription'])
      );
    }

    match /drugs/{drugId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // In prod, restricted to Pharmacist role
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false; // Transactions should be immutable
    }

    match /queue/{queueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
